# Copy to .env for local development. On Fly these go through `fly secrets set`.
TELEGRAM_BOT_TOKEN=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=            # voice transcription only (gpt-4o-transcribe)

# Basic auth for the web view, one login shared by the family
WEB_USER=family
WEB_PASSWORD=

# Telegram user id of the admin: always let in, added to the family on first message.
# Everyone else is added on the web (/family). To learn your id, ask @userinfobot in
# Telegram, or start this bot without ADMIN_USER_ID and write to it: the reply shows it.
ADMIN_USER_ID=

# Database. On Fly: /data/family.db (set in fly.toml)
DATABASE_PATH=./data/family.db

# Public URL of the web view, sent back by /web (e.g. https://familyos.fly.dev)
WEB_URL=

# Model and effort for the single structured-output call per message
LLM_MODEL=claude-sonnet-5
LLM_EFFORT=medium

TZ=Europe/Kyiv
